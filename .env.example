# Copy this file to .env and fill in the keys you have. One AI key is enough;
# without any key the app still works in "copy & paste" mode with any AI chat.
GEMINI_API_KEY = "your gemini api key"
OPENAI_API_KEY = "your openai api key"
ANTHROPIC_API_KEY = "your anthropic api key"

# Optional: photos for the slides
UNSPLASH_CLIENT_ID = "your unsplash api key"
